---
/**
 * DÖNEM KAPANIŞI GÖRSELİ — ayın son günlerinde ne oluyor
 * =================================================================
 * SAP finans modülleri sayfasının konusu: hesap planı, maliyet
 * muhasebesi ve KAPANIŞ süreci. Görsel bunu birebir anlatır — bir
 * dönemin günleri yatay eksende, kapanış penceresi ise dönemin
 * sonunda vurgulanmış bir bant olarak durur ve içinde kapanışın
 * sırasıyla yürüyen adımları vardır.
 *
 * Reconcile.astro ile aynı çizim dili (defter çizgileri, tek vurgu
 * rengi, mono etiketler) ama farklı kompozisyon: biri eşleştirmeyi,
 * bu biri zamanı anlatır.
 *
 * Rakam ya da gün sayısı YAZMAZ. "Kapanışı 3 güne indiririz" gibi bir
 * iddia görselin işi değildir; metin ne söylüyorsa o geçerlidir.
 *
 * tone: 'light' (açık zemin) | 'dark' (koyu zemin)
 * labels: kapanış adımları — sayfadan dile göre geçilir.
 */
interface Props {
  tone?: 'light' | 'dark';
  labels: { period: string; window: string; steps: readonly string[] };
  class?: string;
}

const { tone = 'light', labels, class: className = '' } = Astro.props;

const AXIS_Y = 112;
const START_X = 28;
const END_X = 452;
const DAYS = 30;
/** Kapanış penceresi dönemin son çeyreğinde başlar. */
const WINDOW_FROM = 21;

const dayX = (d: number) => START_X + ((END_X - START_X) * d) / (DAYS - 1);
const winX1 = dayX(WINDOW_FROM);
const winX2 = END_X;

/** Defter zemini — Ledger/Reconcile ile aynı aile. */
const rules = [40, 84, 128, 172, 216, 260];

/** Adımlar pencerenin İÇİNE yazılmaz: dört mono etiket o genişliğe
    sığmıyor ve üst üste biniyordu. Aşağıda alt alta listelenirler. */
const STEP_Y0 = 172;
const STEP_DY = 30;
---

<div class:list={['cc', `cc-${tone}`, className]} aria-hidden="true">
  <svg viewBox="0 0 480 300" focusable="false">
    <g class="cc-rules">
      {rules.map((y) => <line x1="0" y1={y} x2="480" y2={y} />)}
    </g>

    <text class="cc-cap" x={START_X} y="36">{labels.period}</text>

    <!-- Dönemin günleri -->
    <g class="cc-days">
      {
        Array.from({ length: DAYS }, (_, d) => (
          <line x1={dayX(d)} y1={AXIS_Y - 6} x2={dayX(d)} y2={AXIS_Y + 6} />
        ))
      }
      <line class="cc-axis" x1={START_X} y1={AXIS_Y} x2={END_X} y2={AXIS_Y} />
    </g>

    <!-- Kapanış penceresi -->
    <rect class="cc-window" x={winX1} y={AXIS_Y - 30} width={winX2 - winX1} height="60" rx="3" />
    <text class="cc-cap cc-wincap" x={winX1} y={AXIS_Y - 42}>{labels.window}</text>

    <!-- Kapanışta sırayla ne oluyor -->
    <g class="cc-steps">
      {
        labels.steps.map((s, i) => (
          <>
            <line
              class="cc-step-tick"
              x1={START_X}
              y1={STEP_Y0 + STEP_DY * i}
              x2={START_X + 18}
              y2={STEP_Y0 + STEP_DY * i}
            />
            <text class="cc-step" x={START_X + 28} y={STEP_Y0 + STEP_DY * i + 4}>
              {s}
            </text>
          </>
        ))
      }
    </g>

    <!-- Dönem sonu işareti -->
    <circle class="cc-mark" cx={END_X} cy={AXIS_Y} r="4" />
  </svg>
</div>

<style>
  .cc {
    pointer-events: none;
    line-height: 0;
  }
  .cc svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .cc-rules line {
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    opacity: 0.16;
  }

  .cc-days line {
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    opacity: 0.3;
  }
  .cc-axis {
    opacity: 0.55;
  }

  /* Kapanış penceresi: dolgu değil çerçeve — dönemin bir bölümünü
     işaretler, üzerini örtmez. */
  .cc-window {
    fill: var(--cc-accent);
    fill-opacity: 0.1;
    stroke: var(--cc-accent);
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
  }
  .cc-step-tick {
    stroke: var(--cc-accent);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    opacity: 0.75;
  }
  .cc-mark {
    fill: var(--cc-accent);
  }

  .cc-cap {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    fill: currentColor;
    opacity: 0.62;
  }
  .cc-wincap {
    fill: var(--cc-accent);
    opacity: 1;
  }
  .cc-step {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    fill: currentColor;
    opacity: 0.78;
  }

  .cc-light {
    --cc-accent: var(--teal);
    color: var(--navy);
  }
  .cc-dark {
    --cc-accent: var(--amber-on-dark);
    color: #ffffff;
  }
</style>
