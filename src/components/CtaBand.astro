---
/**
 * Kapanış CTA bandı — teal zemin, tek cümle, tek buton.
 * Sitenin tek dönüşüm hedefi iletişim formu olduğu için burada
 * rakip bir eylem (telefon, takvim, bülten) bilinçli olarak yoktur.
 *
 * Beyaz metin / teal zemin kontrastı 6.62:1 — WCAG AA.
 */
import { t } from '@/i18n/ui';
import { path, type Lang } from '@/i18n/routes';

interface Props {
  lang: Lang;
  text: string;
  cta?: string;
}

const { lang, text, cta } = Astro.props;
const ui = t(lang);
---

<section class="cta-band on-teal">
  <div class="container cta-inner reveal">
    <p class="cta-text">{text}</p>
    <a href={path({ page: 'contact' }, lang)} class="btn btn-primary cta-btn">
      {cta ?? ui.cta.primary}
    </a>
  </div>
</section>

<style>
  .cta-band {
    background: var(--teal);
    padding-block: clamp(2.75rem, 1.8rem + 4vw, 4.5rem);
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .cta-text {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.05rem + 1.4vw, 2.1rem);
    font-weight: 550;
    letter-spacing: -0.025em;
    line-height: 1.2;
    color: #fff;
    max-width: 26ch;
    margin: 0;
  }

  .cta-btn {
    flex: none;
  }

  @media (min-width: 52rem) {
    .cta-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-md);
    }
  }
</style>
