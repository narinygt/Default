---
/**
 * İMZA GÖRSEL ÖĞE — "muhasebe defteri → ağ grafiği"
 * =================================================================
 * İnce yatay defter çizgileri, görünür alana girince bir düğüm/ağ
 * grafiğine çözülür. Yapay zeka göndermesi bu soyut dönüşümle
 * verilir; robot/beyin/neon küre gibi ucuz sembol kullanılmaz.
 *
 * Geometri elle ve sabit yazılmıştır — rastgelelik yok, her build
 * aynı görseli üretir.
 *
 * variant:
 *   'hero'    → hero'da duran, kendi çerçevesi olan görsel panel
 *   'band'    → bölüm geçişlerinde ince yatay şerit (%8 opaklık)
 *   'texture' → bir bölümün arkasına serilen doku (%8 opaklık)
 *
 * tone: 'light' (açık zemin) | 'dark' (koyu zemin)
 */
interface Props {
  variant?: 'hero' | 'band' | 'texture';
  tone?: 'light' | 'dark';
  class?: string;
}

const { variant = 'texture', tone = 'light', class: className = '' } = Astro.props;

/** Defter satırları — eşit aralıklı yatay çizgiler. */
const rows = Array.from({ length: 10 }, (_, i) => 40 + i * 40);

/** Düğümler defter satırlarının ÜZERİNE oturur: çizgiler düğüme "çözülür". */
const nodes = [
  { x: 96, y: 120, r: 4 },
  { x: 216, y: 80, r: 3 },
  { x: 330, y: 160, r: 5 },
  { x: 150, y: 240, r: 3 },
  { x: 288, y: 280, r: 4 },
  { x: 402, y: 320, r: 3 },
  { x: 72, y: 336, r: 3 },
  { x: 216, y: 200, r: 6 },
];

/** Kenarlar — düğüm dizinleriyle. */
const edges: [number, number][] = [
  [0, 1], [1, 2], [0, 7], [7, 2], [7, 3],
  [3, 4], [4, 2], [4, 5], [3, 6], [6, 4],
];

const uid = `lg-${Math.random().toString(36).slice(2, 8)}`;
---

<div class:list={['ledger', `ledger-${variant}`, `ledger-${tone}`, className]} aria-hidden="true">
  <svg viewBox="0 0 480 420" preserveAspectRatio="xMidYMid slice" focusable="false">
    <!-- Defter satırları -->
    <g class="ledger-rules">
      {rows.map((y) => <line x1="0" y1={y} x2="480" y2={y} />)}
      <!-- Defterin sol kenar payı çizgisi -->
      <line class="ledger-margin" x1="44" y1="0" x2="44" y2="420" />
    </g>

    <!-- Çizgilerin çözüldüğü ağ -->
    <g class="ledger-net">
      <g class="ledger-edges">
        {
          edges.map(([a, b]) => (
            <line x1={nodes[a].x} y1={nodes[a].y} x2={nodes[b].x} y2={nodes[b].y} />
          ))
        }
      </g>
      <g class="ledger-nodes">
        {nodes.map((n, i) => <circle cx={n.x} cy={n.y} r={n.r} style={`--i:${i}`} />)}
      </g>
    </g>
  </svg>
</div>

<style define:vars={{ uid }}>
  .ledger {
    pointer-events: none;
    line-height: 0;
  }

  .ledger svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* --- Ortak çizgi biçimi --- */
  .ledger-rules line {
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .ledger-margin {
    stroke-width: 1;
    opacity: 0.55;
  }

  .ledger-edges line {
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    opacity: 0;
    transition: opacity 300ms var(--ease) 80ms;
  }

  .ledger-nodes circle {
    fill: currentColor;
    opacity: 0;
    transform: scale(0.4);
    transform-origin: center;
    transform-box: fill-box;
    transition:
      opacity 260ms var(--ease),
      transform 260ms var(--ease);
    /* Düğümler soldan sağa çok kısa bir sırayla belirir. */
    transition-delay: calc(var(--i) * 32ms);
  }

  /* Görünür alana girdiğinde: çizgiler geri çekilir, ağ belirir. */
  .ledger.is-visible .ledger-edges line {
    opacity: 0.9;
  }
  .ledger.is-visible .ledger-nodes circle {
    opacity: 1;
    transform: scale(1);
  }
  .ledger.is-visible .ledger-rules {
    opacity: 0.45;
    transition: opacity 400ms var(--ease);
  }
  .ledger-rules {
    transition: opacity 400ms var(--ease);
  }

  /* --- Varyantlar --- */

  /* Doku ve şerit: brief'in istediği %6–10 opaklık bandı. */
  .ledger-texture,
  .ledger-band {
    position: absolute;
    inset: 0;
    opacity: var(--ledger-opacity);
    z-index: 0;
  }

  /* Doku varyantında UZUN KENARLAR gizlenir.
     Doku geniş bir bölüme yayılırken 480×420'lik viewBox çok
     büyütülür; kenarlar o ölçekte "defter → ağ" dönüşümü olarak değil,
     sayfayı çaprazlama kesen rastgele çizgiler olarak okunur.
     Bu yüzden dokuda yalnızca defter satırları ve düğümler kalır;
     dönüşümün tamamı, okunabilir olduğu hero panelinde gösterilir. */
  .ledger-texture .ledger-edges {
    display: none;
  }
  .ledger-band {
    position: relative;
    height: 120px;
    inset: auto;
  }

  .ledger-light {
    color: var(--navy);
  }
  .ledger-dark {
    color: #ffffff;
  }

  /* Hero paneli: kendi çerçevesi olan, okunur ama sakin bir görsel. */
  .ledger-hero {
    position: relative;
    aspect-ratio: 480 / 420;
    width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
    color: var(--navy);
  }
  /* Hero panelinde defter satırları okunur kalmalı: "muhasebe defteri"
     göndermesi bu panelde veriliyor, tamamen soluklaşırsa kaybolur. */
  .ledger-hero .ledger-rules {
    opacity: 0.32;
  }
  .ledger-hero.is-visible .ledger-rules {
    opacity: 0.2;
  }
  .ledger-hero .ledger-edges line {
    stroke: var(--teal);
  }
  .ledger-hero .ledger-nodes circle {
    fill: var(--teal);
  }
  /* Tek bir düğüm amber — ağdaki "vurgu" noktası, kısıtlı kullanım. */
  .ledger-hero .ledger-nodes circle:nth-child(8) {
    fill: var(--amber);
  }

  /* Hareket kapalıysa: dönüşüm yok, son durum doğrudan gösterilir. */
  @media (prefers-reduced-motion: reduce) {
    .ledger-edges line,
    .ledger-nodes circle {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    .ledger-edges line {
      opacity: 0.9 !important;
    }
  }
</style>
