---
/**
 * MUTABAKAT GÖRSELİ — banka satırları ↔ açık kalemler
 * =================================================================
 * Konusu doğrudan bu sitenin işi: finans mutabakatı. Soldaki sütun
 * banka ekstresi satırlarını, sağdaki sütun sistemdeki açık kalemleri
 * temsil eder; eğri bağlantılar eşleşmeyi gösterir. Eşleşmeler
 * SIRALI DEĞİLDİR — mutabakatın zorluğu tam olarak budur. Bir çift
 * amber renkle işaretlidir: eşleşmeyen / anomali olarak ayrılan kalem.
 *
 * "Yapay zeka" göndermesi robot ya da parlayan küre gibi genel
 * sembollerle değil, işin kendi diliyle verilir — Ledger.astro'daki
 * kuralın aynısı.
 *
 * Geometri elle ve sabit yazılmıştır; her build aynı görseli üretir.
 * Rakam ya da tutar YAZMAZ: uydurma finansal veri göstermek, gerçek
 * gibi okunacağı için kaçınılan bir şeydir.
 *
 * tone: 'light' (açık zemin) | 'dark' (koyu zemin)
 * labels: sütun başlıkları — sayfadan dile göre geçilir.
 */
interface Props {
  tone?: 'light' | 'dark';
  labels: { left: string; right: string; flagged: string };
  class?: string;
}

const { tone = 'light', labels, class: className = '' } = Astro.props;

/** Defter zemini — Ledger.astro ile aynı çizgi dili. */
const rules = Array.from({ length: 7 }, (_, i) => 52 + i * 44);

const ROW_Y = [78, 126, 174, 222, 270];
const LEFT_X = 34;
const LEFT_W = 132;
const RIGHT_X = 314;
const RIGHT_W = 132;

/** Eşleşmeler kasıtlı olarak çapraz: sol satır -> sağ satır. */
const links: { from: number; to: number; flagged?: boolean }[] = [
  { from: 0, to: 2 },
  { from: 1, to: 0 },
  { from: 2, to: 4 },
  { from: 3, to: 1 },
  { from: 4, to: 3, flagged: true },
];

/** İki sütun arasında yumuşak bir S eğrisi. */
const curve = (y1: number, y2: number) => {
  const x1 = LEFT_X + LEFT_W;
  const x2 = RIGHT_X;
  const mid = (x1 + x2) / 2;
  return `M ${x1} ${y1} C ${mid} ${y1}, ${mid} ${y2}, ${x2} ${y2}`;
};
---

<div class:list={['rc', `rc-${tone}`, className]} aria-hidden="true">
  <svg viewBox="0 0 480 320" focusable="false">
    <!-- Defter zemini -->
    <g class="rc-rules">
      {rules.map((y) => <line x1="0" y1={y} x2="480" y2={y} />)}
    </g>

    <!-- Sütun başlıkları -->
    <text class="rc-cap" x={LEFT_X} y="42">{labels.left}</text>
    <text class="rc-cap" x={RIGHT_X} y="42">{labels.right}</text>

    <!-- Eşleştirme bağlantıları -->
    <g class="rc-links">
      {
        links.map((l) => (
          <path
            class:list={['rc-link', l.flagged && 'is-flagged']}
            d={curve(ROW_Y[l.from], ROW_Y[l.to])}
          />
        ))
      }
    </g>

    <!-- Banka ekstresi satırları -->
    <g class="rc-col">
      {
        ROW_Y.map((y, i) => (
          <rect
            class:list={['rc-bar', i === 4 && 'is-flagged']}
            x={LEFT_X}
            y={y - 9}
            width={LEFT_W}
            height="18"
            rx="2"
          />
        ))
      }
    </g>

    <!-- Açık kalemler -->
    <g class="rc-col">
      {
        ROW_Y.map((y, i) => (
          <rect
            class:list={['rc-bar', i === 3 && 'is-flagged']}
            x={RIGHT_X}
            y={y - 9}
            width={RIGHT_W}
            height="18"
            rx="2"
          />
        ))
      }
    </g>

    <!-- İşaretlenen kalem: içi boş halka, dolu nokta değil — "incelenecek"
         demek, "onaylandı" değil. Halka satırın kendi hizasında durur. -->
    <circle class="rc-mark" cx={RIGHT_X + RIGHT_W - 12} cy={ROW_Y[3]} r="5" />

    <!-- Açıklama altta: sağ kenara sıkışan etiket kesiliyordu. -->
    <g class="rc-legend">
      <path class="rc-link is-flagged" d={`M ${LEFT_X} 304 L ${LEFT_X + 26} 304`} />
      <text class="rc-cap rc-flagcap" x={LEFT_X + 34} y="308">{labels.flagged}</text>
    </g>
  </svg>
</div>

<style>
  .rc {
    pointer-events: none;
    line-height: 0;
  }
  .rc svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Defter çizgileri en arkada, çok soluk. */
  .rc-rules line {
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    opacity: 0.16;
  }

  .rc-bar {
    fill: currentColor;
    opacity: 0.16;
  }
  .rc-link {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
    opacity: 0.5;
  }

  /* Tek vurgu rengi yalnızca işaretli kalemde. */
  .rc-bar.is-flagged {
    fill: var(--rc-accent);
    opacity: 0.5;
  }
  .rc-link.is-flagged {
    stroke: var(--rc-accent);
    stroke-dasharray: 4 3;
    opacity: 0.95;
  }
  .rc-mark {
    fill: none;
    stroke: var(--rc-accent);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .rc-cap {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    fill: currentColor;
    opacity: 0.62;
  }
  .rc-flagcap {
    fill: var(--rc-accent);
    opacity: 0.95;
  }

  /* Açık zeminde amber, koyu zeminde açık amber: küçük yazıda
     kontrastı tutan sürüm budur (global.css'teki kontrast tablosu). */
  .rc-light {
    --rc-accent: var(--amber);
    color: var(--navy);
  }
  .rc-dark {
    --rc-accent: var(--amber-on-dark);
    color: #ffffff;
  }
</style>
