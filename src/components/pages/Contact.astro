---
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ContactForm from '@/components/ContactForm.astro';
import Field from '@/components/Field.astro';
import ContactIcon from '@/components/ContactIcon.astro';
import { type Lang } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { contact } from '@/data/pages/contact';
import { site, addressLines, mapsUrl } from '@/config/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t(lang);
const c = contact[lang];

const lines = addressLines();
/**
 * Adres tamamlanmadan harita bağlantısı gösterilmez: `mapsUrl()`
 * placeholder bir adres için `null` döner.
 */
const mapHref = mapsUrl();
---

<section class="ct">
  <div class="container">
    <Breadcrumbs
      lang={lang}
      trail={[{ name: lang === 'tr' ? 'Ana sayfa' : 'Home', ref: { page: 'home' } }]}
      current={ui.nav.contact}
    />

    <div class="ct-head">
      <h1>{c.hero.h1}</h1>
      <p class="lead">{c.hero.lead}</p>
    </div>

    <!-- Form fold üstünde: ziyaretçi kaydırmadan formu görür. -->
    <div class="ct-grid">
      <div class="ct-form">
        <ContactForm lang={lang} />
      </div>

      <aside class="ct-aside">
        <!-- Doğrudan iletişim -->
        <div class="ct-block">
          <h2 class="mono ct-block-title">{c.aside.directTitle}</h2>
          <p class="ct-block-note">{c.aside.directBody}</p>
          <ul class="ct-contacts">
            <li>
              <ContactIcon name="mail" class="ct-icon" />
              <span class="mono ct-key">{site.contact.direct.name}</span>
              <Field lang={lang} value={site.contact.direct.email} href={(v) => `mailto:${v}`} />
            </li>
            <li>
              <ContactIcon name="mail" class="ct-icon" />
              <span class="mono ct-key">{lang === 'tr' ? 'Genel e-posta' : 'General email'}</span>
              <Field lang={lang} value={site.contact.email} href={(v) => `mailto:${v}`} />
            </li>
            <li>
              <ContactIcon name="phone" class="ct-icon" />
              <span class="mono ct-key">{lang === 'tr' ? 'Telefon' : 'Phone'}</span>
              <Field
                lang={lang}
                value={site.contact.phone}
                href={(v) => `tel:${v.replace(/[^\d+]/g, '')}`}
              />
            </li>
            <li>
              <ContactIcon name="linkedin" class="ct-icon" />
              <span class="mono ct-key">LinkedIn</span>
              <Field lang={lang} value={site.contact.linkedin} href={(v) => v} />
            </li>
          </ul>
        </div>

        <!-- Yanıt süresi -->
        <div class="ct-block ct-block-accent">
          <h2 class="mono ct-block-title">{c.aside.responseTitle}</h2>
          <p class="ct-response">{c.aside.responseBody}</p>
        </div>

        <!-- Çalışma saatleri -->
        <div class="ct-block">
          <h2 class="mono ct-block-title">{c.aside.hoursTitle}</h2>
          <p class="ct-hours">{ui.footer.hoursValue}</p>
        </div>

        <!-- Adres -->
        <div class="ct-block">
          <h2 class="mono ct-block-title ct-title-icon">
            <ContactIcon name="pin" size={15} />
            {c.aside.addressTitle}
          </h2>
          <address class="ct-address">
            {
              mapHref ? (
                /* Adresin tamamı tek bir bağlantı: tıklayan ziyaretçi
                   doğrudan haritada konuma gider. Mobilde yüklü Maps
                   uygulaması, masaüstünde yeni sekme açılır. */
                <a
                  class="ct-address-link"
                  href={mapHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={ui.common.openInMapsAria}
                >
                  {lines.map((line) => (
                    <span class="ct-addr-line">{line.text}</span>
                  ))}
                </a>
              ) : (
                lines.map((line) =>
                  line.pending ? (
                    <span class="todo">{line.text}</span>
                  ) : (
                    <span class="ct-addr-line">{line.text}</span>
                  ),
                )
              )
            }
          </address>

          {!mapHref && <p class="ct-map-note">{c.aside.mapNote}</p>}
        </div>

        <!-- Sonrasında ne oluyor -->
        <div class="ct-block">
          <h2 class="mono ct-block-title">{c.aside.whatHappensTitle}</h2>
          <ol class="ct-steps">
            {c.aside.whatHappens.map((s) => <li>{s}</li>)}
          </ol>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .ct {
    padding-block: var(--space-sm) var(--section-y);
  }

  /* Başlık bloğu bilinçli olarak KÜÇÜK tutulmuştur.
     Bu sayfanın işi form doldurtmaktır; ana sayfa ölçeğinde bir H1
     formu ekranın altına iter. Brief'in "form fold üstünde görünsün"
     gereksinimi buradaki ölçüyle sağlanır. */
  .ct-head {
    max-width: 46rem;
    margin-block: var(--space-sm) var(--space-md);
  }
  .ct-head h1 {
    font-size: clamp(1.9rem, 1.5rem + 1.5vw, 2.6rem);
  }
  .ct-head .lead {
    margin-top: 0.6rem;
    font-size: 1.05rem;
  }

  .ct-grid {
    display: grid;
    gap: var(--space-md);
    align-items: start;
  }
  @media (min-width: 62rem) {
    .ct-grid {
      grid-template-columns: 1.35fr 1fr;
      gap: var(--space-lg);
    }
    /* Yan sütun uzun formda birlikte kayar. */
    .ct-aside {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
  }

  .ct-aside {
    display: grid;
    gap: var(--space-sm);
  }

  .ct-block {
    padding: var(--space-sm);
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
  }
  .ct-block-accent {
    border-left: 2px solid var(--teal);
  }

  .ct-block-title {
    color: var(--text-muted);
    font-size: var(--step-mono);
    margin-bottom: var(--space-xs);
    font-weight: 500;
  }
  .ct-block-note {
    font-size: 0.92rem;
    color: var(--text-muted);
    margin-bottom: var(--space-xs);
  }

  .ct-contacts {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-xs);
  }
  /* İkon + etiket + değer: ikon ilk sütunda sabit, değer alt satıra
     iner ve etiketin altına DEĞİL, ikonun sağına hizalanır. */
  .ct-contacts li {
    display: grid;
    /* `minmax(0, 1fr)`: uzun bir değer (LinkedIn adresi gibi) ikinci
       sütunu zorlayınca `auto` sütun eziliyor ve ikon küçülüyordu. */
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 0.55rem;
    align-items: baseline;
  }
  /* `:global()` şart: ikon, ayrı bir bileşenin kök elemanı olduğu için
     bu dosyanın kapsam etiketini taşımaz — kapsamlı seçici ona ulaşmaz
     ve renk kuralı sessizce düşerdi. */
  .ct-contacts :global(.ct-icon),
  .ct-title-icon :global(.cicon) {
    color: var(--teal);
    transform: translateY(0.15em);
  }
  .ct-title-icon :global(.cicon) {
    transform: none;
  }
  .ct-contacts li > :global(*:nth-child(3)) {
    grid-column: 2;
  }
  .ct-title-icon {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .ct-contacts li {
    display: grid;
    gap: 0.15rem;
    font-size: 0.98rem;
    word-break: break-word;
  }
  .ct-key {
    color: var(--text-muted);
    font-size: 0.68rem;
    /* "LinkedIn" Türkçe büyük harf kuralında "LİNKEDİN" olur. */
    text-transform: none;
    letter-spacing: 0.03em;
  }
  .ct-contacts :global(a) {
    color: var(--teal);
    text-decoration: none;
  }
  .ct-contacts :global(a:hover) {
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .ct-response,
  .ct-hours {
    font-size: 0.97rem;
    line-height: 1.55;
    color: var(--text);
    margin: 0;
  }

  .ct-address {
    font-style: normal;
    display: grid;
    gap: 0.2rem;
    font-size: 0.97rem;
    color: var(--text);
  }
  .ct-addr-line {
    display: block;
  }

  /* Adres bağlantısı. Kapsamsız `a { color: var(--teal) }` kuralı
     adresi bağlantı mavisine çevirmesin diye renk burada gövde metnine
     sabitlenir; tıklanabilir olduğunu hover'daki alt çizgi gösterir.
     Aynı desen Footer.astro'da da kullanılır. */
  .ct-address :global(a.ct-address-link) {
    display: grid;
    gap: 0.2rem;
    color: var(--text);
    text-decoration: none;
    border-radius: var(--radius);
  }
  .ct-address :global(a.ct-address-link:hover) .ct-addr-line {
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .ct-map-note {
    margin-top: var(--space-xs);
    padding-top: var(--space-xs);
    border-top: 1px dashed var(--border);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .ct-steps {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.55rem;
  }
  .ct-steps li {
    font-size: 0.93rem;
    line-height: 1.55;
    color: var(--text-muted);
    padding-left: 0.25rem;
  }
  .ct-steps li::marker {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--teal);
  }
</style>
