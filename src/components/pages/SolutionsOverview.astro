---
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SolutionCard from '@/components/SolutionCard.astro';
import Ledger from '@/components/Ledger.astro';
import { SOLUTION_KEYS, path, type Lang } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { solutionMeta } from '@/data/solutions';
import { figures } from '@/data/figures';
import { solutionsOverview } from '@/data/pages/solutionsOverview';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t(lang);
const c = solutionsOverview[lang];
---

<!-- ============ HERO ============ -->
<section class="ov-hero">
  <Ledger variant="texture" tone="light" class="ov-texture" />
  <div class="container ov-hero-inner">
    <Breadcrumbs
      lang={lang}
      trail={[{ name: lang === 'tr' ? 'Ana sayfa' : 'Home', ref: { page: 'home' } }]}
      current={ui.nav.solutions}
    />
    <div class="ov-hero-copy reveal">
      <h1>{c.hero.h1}</h1>
      <p class="lead">{c.hero.lead}</p>
    </div>
  </div>
</section>

<!-- ============ ÇÖZÜM KARTLARI ============ -->
<section class="section-sm" aria-labelledby="ov-cards-title">
  <div class="container">
    {/* Kartların başlığı h3; araya h2 girmediği için başlık sırası
        h1'den h3'e atlıyordu. Görünür bir başlık tasarımı bozardı,
        bu yüzden yalnızca ekran okuyucuya ve belge yapısına giden
        bir h2 eklendi. */}
    <h2 id="ov-cards-title" class="sr-only">{ui.nav.solutions}</h2>
    <div class="grid grid-3 solutions-grid">
      {SOLUTION_KEYS.map((key, i) => <SolutionCard lang={lang} solution={key} delay={i} />)}
    </div>
  </div>
</section>

<!-- ============ KARŞILAŞTIRMA TABLOSU ============ -->
<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <h2>{c.compare.h2}</h2>
      <p class="lead">{c.compare.lead}</p>
    </div>

    <div class="table-scroll reveal compare-table">
      <table>
        <caption>{c.compare.caption}</caption>
        <thead>
          <tr>
            <th scope="col">{c.compare.headers.solution}</th>
            <th scope="col">{c.compare.headers.forWhom}</th>
            <th scope="col">{c.compare.headers.duration}</th>
            <th scope="col">{c.compare.headers.mainGain}</th>
          </tr>
        </thead>
        <tbody>
          {
            SOLUTION_KEYS.map((key) => {
              const s = solutionMeta[key][lang];
              return (
                <tr>
                  <th scope="row">
                    <a href={path({ solution: key }, lang)}>{s.navTitle}</a>
                  </th>
                  <td data-label={c.compare.headers.forWhom}>{s.comparison.forWhom}</td>
                  <td class="cell-mono" data-label={c.compare.headers.duration}>
                    {s.comparison.duration}
                  </td>
                  <td data-label={c.compare.headers.mainGain}>{s.comparison.mainGain}</td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- ============ PUBLIC vs PRIVATE CLOUD ============ -->
<section class="section cloud-section">
  <div class="container">
    <div class="section-head reveal">
      {/* lang="en": SAP ürün adları Türkçe büyük harf kuralıyla bozulmasın. */}
      <p class="eyebrow" lang="en">Public Cloud / Private Cloud</p>
      <h2>{c.cloud.h2}</h2>
      <p class="lead">{c.cloud.lead}</p>
    </div>

    <img
      class="section-figure reveal"
      data-figure="cloudModels"
      src={figures.cloudModels.src[lang]}
      width="1536"
      height="1024"
      alt={figures.cloudModels.alt[lang]}
      loading="lazy"
      decoding="async"
    />

    <div class="cloud-intro reveal">
      {c.cloud.intro.map((p) => <p>{p}</p>)}
    </div>

    <div class="table-scroll reveal cloud-table">
      <table>
        <caption>{c.cloud.caption}</caption>
        <thead>
          <tr>
            <th scope="col">{c.cloud.headers.criterion}</th>
            <th scope="col">{c.cloud.headers.publicCloud}</th>
            <th scope="col">{c.cloud.headers.privateCloud}</th>
          </tr>
        </thead>
        <tbody>
          {
            c.cloud.rows.map((row) => (
              <tr>
                <th scope="row">{row.criterion}</th>
                <td data-label={c.cloud.headers.publicCloud}>{row.publicCloud}</td>
                <td data-label={c.cloud.headers.privateCloud}>{row.privateCloud}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <!-- Karar rehberi -->
    <div class="guidance reveal">
      <h3>{c.cloud.guidance.h3}</h3>
      <div class="grid grid-2 guidance-grid">
        <div class="guidance-col">
          <h4>{c.cloud.guidance.publicTitle}</h4>
          <ul class="checklist">
            {c.cloud.guidance.publicItems.map((i) => <li>{i}</li>)}
          </ul>
          <a href={path({ solution: 'publicCloud' }, lang)} class="link-arrow guidance-link">
            {solutionMeta.publicCloud[lang].navTitle}
          </a>
        </div>

        <div class="guidance-col">
          <h4>{c.cloud.guidance.privateTitle}</h4>
          <ul class="checklist">
            {c.cloud.guidance.privateItems.map((i) => <li>{i}</li>)}
          </ul>
          <a href={path({ solution: 'privateCloud' }, lang)} class="link-arrow guidance-link">
            {solutionMeta.privateCloud[lang].navTitle}
          </a>
        </div>
      </div>
      <p class="guidance-note">{c.cloud.guidance.note}</p>
    </div>
  </div>
</section>

<!-- ============ NEREDEN BAŞLAMALI ============ -->
<section class="section">
  <div class="container container-narrow">
    <div class="section-head reveal">
      <h2>{c.howToChoose.h2}</h2>
    </div>
    <div class="stack reveal start-body">
      {c.howToChoose.body.map((p) => <p>{p}</p>)}
    </div>
  </div>
</section>

<style>
  .ov-hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-sm) clamp(2rem, 1.2rem + 3vw, 3.5rem);
  }
  .ov-texture {
    left: 55%;
  }
  .ov-hero-inner {
    position: relative;
    z-index: 1;
  }
  .ov-hero-copy {
    max-width: 48rem;
    margin-top: var(--space-md);
  }
  .ov-hero-copy .lead {
    margin-top: var(--space-sm);
  }

  .cell-mono {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    white-space: nowrap;
    color: var(--text-muted);
  }

  /* ---------- Bulut karşılaştırması ---------- */
  .cloud-section {
    background: var(--surface);
    border-block: 1px solid var(--border-soft);
  }
  .cloud-intro {
    display: grid;
    gap: var(--space-sm);
    max-width: 66ch;
    margin-bottom: var(--space-md);
  }
  .cloud-intro p {
    color: var(--text-muted);
  }

  /* Otomatik tablo düzeni sütun genişliğini metin uzunluğuna göre
     dağıtıyor; iki karşılaştırma sütunu 50 px'e varan farkla bitip
     tablo dengesiz görünüyordu. Sabit düzende ölçü içerikten değil
     buradan gelir: ilk sütun 12rem, kalan genişlik ikiye eşit bölünür. */
  .cloud-table table {
    min-width: 52rem;
    table-layout: fixed;
  }
  .cloud-table thead th:first-child {
    width: 12rem;
  }
  .cloud-table td,
  .cloud-table tbody th {
    overflow-wrap: break-word;
  }
  .cloud-table td {
    font-size: 0.94rem;
    line-height: 1.55;
    color: var(--text-muted);
  }
  .cloud-table tbody th {
    color: var(--navy);
    width: 12rem;
  }

  /* ---------- Karar rehberi ---------- */
  .guidance {
    margin-top: var(--space-lg);
    padding: var(--space-md);
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .guidance h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-sm);
  }
  .guidance-grid {
    gap: var(--space-md);
  }
  .guidance-col h4 {
    color: var(--teal);
    margin-bottom: var(--space-xs);
    font-size: 1rem;
  }
  .guidance-col .checklist li {
    font-size: 0.97rem;
    color: var(--text-muted);
  }
  .guidance-col {
    display: flex;
    flex-direction: column;
  }
  /* Listelerin madde sayısı eşit değil; bağlantı `auto` üst boşlukla
     aşağı itilince iki sütun aynı hizada bitiyor. */
  .guidance-link {
    margin-top: auto;
    padding-top: var(--space-sm);
    font-size: 0.92rem;
  }
  .guidance-note {
    margin-top: var(--space-md);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--border);
    font-size: 0.94rem;
    color: var(--text-muted);
    max-width: 74ch;
  }

  .start-body p {
    color: var(--text-muted);
    line-height: 1.68;
  }

  /* ---------- Dar ekran: tablo yerine satır blokları ----------
     Tablet ve telefonda üç/dört sütun yan yana sığmıyordu; kutu yatay
     kayıyor ama kaydığına dair bir işaret vermediği için son sütun
     kesilmiş gibi görünüyordu. Bu genişliklerin altında her satır
     kendi bloğuna açılır: ölçüt başlık olur, sütun başlıkları da
     hücrelerin üstüne etiket olarak (data-label) geçer. */
  @media (max-width: 56rem) {
    .table-scroll {
      overflow-x: visible;
    }
    .table-scroll table {
      min-width: 0;
      table-layout: auto;
    }
    .table-scroll table,
    .table-scroll tbody,
    .table-scroll tr,
    .table-scroll tbody th,
    .table-scroll td {
      display: block;
      width: auto;
    }
    /* Tablo bloğa döndüğü için `table-caption` genişliğini kaybediyor
       ve başlık tek kelimelik satırlara düşüyordu. */
    .table-scroll caption {
      display: block;
    }
    /* Başlık satırı hücre etiketlerine taşındığı için gizlenir. */
    .table-scroll thead {
      display: none;
    }
    .table-scroll tr {
      padding: var(--space-sm) 1.1rem;
      border-bottom: 1px solid var(--border);
    }
    .table-scroll tr:last-child {
      border-bottom: 0;
    }
    .table-scroll tbody th {
      padding: 0 0 0.55rem;
      border: 0;
      font-size: 1.05rem;
    }
    .table-scroll td {
      padding: 0;
      border: 0;
    }
    .table-scroll td + td {
      margin-top: 0.75rem;
    }
    .table-scroll td::before {
      content: attr(data-label);
      display: block;
      margin-bottom: 0.15rem;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--teal);
    }
    /* Yığılmış görünümde süre tek satıra sığmak zorunda değil. */
    .cell-mono {
      white-space: normal;
    }
  }
</style>
