---
import Base from '@/layouts/Base.astro';
import Ledger from '@/components/Ledger.astro';
import References from '@/components/References.astro';
import SolutionCard from '@/components/SolutionCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import { LANGS, SOLUTION_KEYS, path, type Lang } from '@/i18n/routes';
import { site } from '@/config/site';
import { t } from '@/i18n/ui';
import { figures } from '@/data/figures';
import { home } from '@/data/home';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const ui = t(lang);
const c = home[lang];

/** Hero görsel seçeneği — src/config/site.ts içinden. */
const heroVisual = site.hero.visual;
const isLedger = heroVisual === 'ledger';
const isBackground = heroVisual === 'background';
/** 'duotone' eski kuantum kaynağında kalır; 'image' ve 'background' yeni
 * fotoğrafı (hero-team.webp) kullanır — ikisinin doğal boyutu farklı
 * olduğu için width/height de görsele göre ayrılır (CLS'i önlemek için). */
const imageSrc =
  heroVisual === 'duotone' ? '/media/quantum-duotone.webp' : '/media/hero-team.webp';
const imageDims =
  heroVisual === 'duotone' ? { w: 800, h: 942 } : { w: 1200, h: 800 };
---

<Base
  lang={lang}
  ref={{ page: 'home' }}
  title={c.meta.title}
  description={c.meta.description}
  darkTop={isBackground}
  preloadImage={isLedger ? undefined : imageSrc}
>
  <!-- ============ 1. HERO ============
       Görsel seçeneği src/config/site.ts → hero.visual ile değişir:
       'ledger' | 'image' | 'duotone' | 'background'                  -->
  <section class:list={['hero', `hero-${heroVisual}`]} data-hero>
    {
      /* Tam ekran seçeneği: görsel hero'nun TAMAMINI kaplar, metin
         onun üzerinde durur. Okunabilirliği `.hero-scrim` sağlar. */
      isBackground && (
        <div class="hero-bg" aria-hidden="true">
          {/* Alt katman: aynı fotoğrafın büyütülüp buğulanmış hali —
              toplantı odasının sola doğru uzamış, odak dışı devamı. */}
          <img
            class="hero-bg-soft"
            src={imageSrc}
            width={imageDims.w}
            height={imageDims.h}
            alt=""
            fetchpriority="high"
          />
          {/* Üst katman: net fotoğraf, sağda. Sola doğru maskeyle
              biter ve alttaki buğulu devamına karışır. */}
          <img
            class="hero-bg-sharp"
            src={imageSrc}
            width={imageDims.w}
            height={imageDims.h}
            alt=""
            fetchpriority="high"
          />
          <div class="hero-scrim" />
        </div>
      )
    }

    {!isBackground && <Ledger variant="texture" tone="light" class="hero-texture" />}

    <div class="container hero-inner">
      <div class="hero-copy reveal">
        <h1>{c.hero.h1}</h1>
        <p class="lead hero-lead">{c.hero.lead}</p>
        <div class="btn-row">
          <a href={path({ page: 'contact' }, lang)} class="btn btn-primary">{c.hero.primaryCta}</a>
          <a href={path({ page: 'solutions' }, lang)} class="btn btn-secondary">
            {c.hero.secondaryCta}
          </a>
        </div>
      </div>

      {
        !isBackground && (
          <figure class="hero-figure reveal" data-delay="1">
            {isLedger ? (
              <>
                <Ledger variant="hero" />
                <figcaption class="sr-only">{c.hero.figureAlt}</figcaption>
              </>
            ) : (
              <div class:list={['hero-panel', heroVisual === 'image' && 'hero-panel--photo']}>
                <img
                  src={imageSrc}
                  width={imageDims.w}
                  height={imageDims.h}
                  alt={c.hero.imageAlt}
                  fetchpriority="high"
                />
              </div>
            )}
          </figure>
        )
      }
    </div>
  </section>

  <!-- ============ 2. REFERANSLAR ŞERİDİ ============
       Hero'nun ALTINDA, kendi yeşil zeminli bandı olarak. Bir ara
       hero'nun içine, görselin üzerine alınmıştı; şerit halinde daha
       iyi durduğu için geri getirildi. Logolar kendi renklerinde
       olduğu için düz ve tek renk bir zemin, fotoğrafın üzerinden
       çok daha okunur.
       Liste ve ölçü mantığı: src/data/references.ts             -->
  <References lang={lang} />

  <!-- ============ 3. ÇÖZÜMLER IZGARASI ============ -->
  <section class="section" id="solutions">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">{c.solutions.eyebrow}</p>
        <h2>{c.solutions.h2}</h2>
        <p class="lead">{c.solutions.lead}</p>
      </div>

      <div class="grid grid-3 solutions-grid">
        {SOLUTION_KEYS.map((key, i) => <SolutionCard lang={lang} solution={key} delay={i} />)}
      </div>

      <p class="solutions-all reveal">
        <a href={path({ page: 'solutions' }, lang)} class="link-arrow">{c.solutions.allLink}</a>
      </p>
    </div>
  </section>

  <!-- ============ 4. NEDEN CPEAK ============ -->
  <section class="section why-section">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">{c.why.eyebrow}</p>
        <h2>{c.why.h2}</h2>
        <p class="lead">{c.why.lead}</p>
      </div>

      <div class="grid grid-4 why-grid">
        {
          c.why.items.map((item, i) => (
            <div class="why-item reveal" data-delay={String(Math.min(i, 3))}>
              <hr class="rule-teal" />
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ 5. YAPAY ZEKÂ YAKLAŞIMIMIZ ============
       Ayrı, koyu lacivert zeminli bölüm. -->
  <section class="section ai-section on-dark">
    <Ledger variant="texture" tone="dark" />

    <div class="container ai-inner">
      <div class="section-head reveal">
        <p class="eyebrow">{c.aiSection.eyebrow}</p>
        <h2>{c.aiSection.h2}</h2>
        <p class="lead">{c.aiSection.lead}</p>
      </div>

      <div class="grid grid-2 ai-grid">
        <div class="ai-col reveal">
          <h3>{c.aiSection.forClients.title}</h3>
          <p>{c.aiSection.forClients.body}</p>
          <ul class="dashlist">
            {c.aiSection.forClients.items.map((i) => <li>{i}</li>)}
          </ul>
        </div>

        <div class="ai-col reveal" data-delay="1">
          <h3>{c.aiSection.ourPractice.title}</h3>
          <p>{c.aiSection.ourPractice.body}</p>
          <ul class="dashlist">
            {c.aiSection.ourPractice.items.map((i) => <li>{i}</li>)}
          </ul>
        </div>
      </div>

      <p class="ai-stance reveal">{c.aiSection.stance}</p>
    </div>
  </section>

  <!-- ============ 6. ÇALIŞMA YAKLAŞIMI ============
       Monospace numaralandırma burada anlamlı: gerçekten sıralı
       bir süreci gösteriyor. -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">{c.process.eyebrow}</p>
        <h2>{c.process.h2}</h2>
        <p class="lead">{c.process.lead}</p>
      </div>

      <img
        class="section-figure reveal"
        src={figures.process.src[lang]}
        width="1536"
        height="1024"
        alt={figures.process.alt[lang]}
        loading="lazy"
        decoding="async"
      />

      <ol class="process-list">
        {
          c.process.steps.map((step, i) => (
            <li class="process-step reveal" data-delay={String(Math.min(i, 3))}>
              <span class="process-no mono">{step.no}</span>
              <h3 class="process-title">{step.title}</h3>
              <p class="process-what">{step.what}</p>
              <dl class="process-meta">
                <div>
                  <dt class="mono">{ui.common.deliverables}</dt>
                  <dd>{step.deliverable}</dd>
                </div>
                <div>
                  <dt class="mono">{ui.common.typicalDuration}</dt>
                  <dd>{step.duration}</dd>
                </div>
              </dl>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ 7. TİPİK PROJE SENARYOLARI ============
       Gerçek müşteri vakası DEĞİL — her kart açıkça işaretli. -->
  <section class="section scenarios-section">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">{c.scenarios.eyebrow}</p>
        <h2>{c.scenarios.h2}</h2>
        <p class="lead">{c.scenarios.lead}</p>
      </div>

      <p class="scenario-disclaimer reveal">{c.scenarios.disclaimer}</p>

      <div class="grid grid-3 scenario-grid">
        {
          c.scenarios.items.map((s, i) => (
            <article class="card scenario-card reveal" data-delay={String(Math.min(i, 3))}>
              <p class="scenario-tag mono">{c.scenarios.tag}</p>
              <h3 class="scenario-sector">{s.sector}</h3>
              <p class="scenario-scale mono">{s.scale}</p>

              <dl class="scenario-body">
                <dt>{lang === 'tr' ? 'Tipik problem' : 'The problem'}</dt>
                <dd>{s.problem}</dd>
                <dt>{lang === 'tr' ? 'İzlenen yaklaşım' : 'Our approach'}</dt>
                <dd>{s.approach}</dd>
                <dt>{lang === 'tr' ? 'Beklenen kazanım' : 'Expected outcome'}</dt>
                <dd>{s.outcome}</dd>
              </dl>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ 8. KAPANIŞ CTA ============ -->
  <CtaBand lang={lang} text={c.closing.text} cta={c.closing.cta} />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 1rem + 6vw, 5.5rem) clamp(3rem, 1.5rem + 6vw, 6rem);
  }
  .hero-texture {
    /* Doku yalnızca sağ tarafa doğru açılır, metnin altında kalmaz. */
    left: 40%;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }

  .hero-lead {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .hero-figure {
    margin: 0;
  }

  @media (min-width: 60rem) {
    .hero-inner {
      grid-template-columns: 1.15fr 1fr;
      gap: var(--space-xl);
    }
  }

  /* ---------- Hero seçeneği: görsel panel (image / duotone) ----------
     Kesim görselin siyah zemini kaldırıldığı için nesne lacivert
     panelin üzerinde serbest durur; kutu içinde fotoğraf gibi değil,
     markanın zemini üzerinde bir nesne gibi okunur. */
  .hero-panel {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 480 / 420;
    padding: clamp(0.75rem, 0.4rem + 1.5vw, 1.75rem);
    background: var(--navy);
    border-radius: var(--radius);
    overflow: hidden;
  }
  /* Panelin içinde çok soluk defter çizgileri: görsel değişse de
     markanın imza dokusu tamamen kaybolmaz. */
  .hero-panel::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.07) 0 1px,
      transparent 1px 34px
    );
    pointer-events: none;
  }
  .hero-panel img {
    position: relative;
    max-height: 100%;
    width: auto;
    object-fit: contain;
  }

  /* ---------- Hero seçeneği: gerçek fotoğraf (image, opak dikdörtgen) ----
     hero-team.webp saydam kesim değil, dolu bir fotoğraf — lacivert/teal
     panel zemini ve iç boşluk (padding) fotoğrafın etrafında renkli bir
     çerçeve gibi görünüyordu. Fotoğrafta bu istenmiyor: zemin şeffaf,
     boşluk sıfır, görsel kendi en/boy oranıyla (3/2) çerçeveyi eksiksiz
     doldurur — arkasında hiçbir renk kalmaz. */
  .hero-panel--photo {
    aspect-ratio: 3 / 2;
    padding: 0;
    background: transparent;
  }
  .hero-panel--photo::before {
    display: none;
  }
  .hero-panel--photo img {
    width: 100%;
    height: 100%;
    max-height: none;
    object-fit: cover;
  }

  /* ---------- Hero seçeneği: TAM EKRAN görsel (background) ----------
     Görsel hero'nun tamamını kaplar ve metin onun üzerinde durur.

     Okunabilirlik iki katmanla sağlanır:
       .hero-bg::after  Tüm alana ince bir karartma — üstteki header ve
                        alttaki kenar her koşulda okunur kalır.
       .hero-scrim      Metnin arkası: koyulaşır VE hafifçe buğulanır.
                        Sağa doğru maskeyle biter, böylece görselin
                        kendisi (asıl gösterilmek istenen şey) net
                        durur. Karartma tek başına da yeterdi; buğu,
                        metnin arkasındaki detayın gözü yormaması için.

     ÖLÇÜ SINIRI: kaynak 1200×800. Tam ekran kullanımda geniş
     masaüstlerinde büyütülüyor; buğulanan sol tarafta bu görünmez ama
     sağdaki net alanda çok büyük ekranlarda yumuşama olabilir. Daha
     yüksek çözünürlüklü bir kaynak gelirse tek yapılacak dosyayı
     değiştirmek. */
  .hero-background {
    /* Hero YEŞİL; header ve çerez banner'ı lacivert kalır (ayrı token). */
    background: var(--surface-hero);
    color: #fff;
    /* Hero + header birlikte TAM BİR EKRAN tutar; logo şeridi de bu
       ekranın içinde, en altta kalır. `dvh` mobil için: `vh` tarayıcı
       adres çubuğunu hesaba katmaz ve şerit ekranın altından taşardı. */
    /* -1px: header'ın alt kenarlığı da yer kaplar; hesaba katılmazsa
       sayfa tam 1 piksel kayıyor. */
    min-height: calc(100vh - var(--header-h) - 1px);
    min-height: calc(100dvh - var(--header-h) - 1px);
    display: flex;
    flex-direction: column;
    padding-block: 0;
  }
  /* Metin bloğu kalan alanı doldurur ve içinde dikey ortalanır;
     logo şeridi altta sabit kalır. */
  .hero-background .hero-inner {
    flex: 1 1 auto;
    align-content: center;
    padding-block: clamp(2rem, 1rem + 4vw, 4rem);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  /* İKİ KATMAN — fotoğraf koyu bir perdeyle bastırılmaz.
     ------------------------------------------------------------------
     Önceki kurulumda metnin arkası kalın bir karartmayla kapatılıyor ve
     fotoğraf o tarafta tamamen ölüyordu. Şimdi metnin arkasındaki şey de
     fotoğrafın KENDİSİ: aynı kare büyütülüp buğulanarak sola doğru
     uzatılıyor, yani toplantı odası odak dışına çıkarak devam ediyor.
     Net kare sağda kalır ve maskeyle bu buğulu devamına karışır. */
  .hero-bg img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Sağa kaydırılır: robotlar sağda kalır, sol taraf metne ayrılır. */
    object-position: 68% center;
  }
  /* Buğulu devam. Büyütülür (blur kenarlarda saydamlık bırakmasın) ve
     hafifçe sola kaydırılır — aynı karenin kopyası gibi değil, odanın
     devamı gibi okunsun. */
  .hero-bg-soft {
    transform: scale(1.35) translateX(-7%);
    /* brightness: fotoğrafı bastırmak için DEĞİL, odak dışı bir alanın
       doğal olarak daha sönük durması için. Metnin okunabilirliği bu
       değere bağlı değil — ölçüm, harf piksellerinin altındaki en kötü
       noktada bile eşiğin üstünde kaldığını gösteriyor. */
    filter: blur(26px) saturate(1.05) brightness(0.78);
  }
  /* Net kare yalnızca sağda. Geçiş uzun tutulur ki iki katmanın birleşim
     yeri belli olmasın. */
  .hero-bg-sharp {
    -webkit-mask-image: linear-gradient(to right, transparent 8%, #000 58%);
    mask-image: linear-gradient(to right, transparent 8%, #000 58%);
  }
  /* Üst ve alt kenarda çok hafif koyulaşma: header ile şeridin
     sınırları belirsizleşmesin. Fotoğrafı bastıracak yoğunlukta
     DEĞİL. */
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(5, 31, 32, 0.34) 0%,
      rgba(5, 31, 32, 0) 26%,
      rgba(5, 31, 32, 0) 74%,
      rgba(5, 31, 32, 0.34) 100%
    );
  }
  /* Metnin okunması için gereken EN AZ koyulaşma. Buğulu katman zaten
     kontrastı düşürdüğü için buradaki değerler eskisinin çok altında. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(6, 36, 37, 0.5) 0%,
      rgba(6, 36, 37, 0.3) 40%,
      rgba(6, 36, 37, 0) 66%
    );
  }
  .hero-background h1 {
    color: #fff;
  }
  .hero-background .hero-lead {
    color: var(--text-on-dark-muted);
  }
  /* Koyu hero'da butonlar ters çevrilir. */
  .hero-background .btn-primary {
    background: #fff;
    color: var(--navy);
    border-color: #fff;
  }
  .hero-background .btn-primary:hover {
    background: var(--amber);
    color: var(--ink);
    border-color: var(--amber);
  }
  .hero-background .btn-secondary {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.35);
    background: transparent;
  }
  .hero-background .btn-secondary:hover {
    border-color: #fff;
    color: #fff;
  }
  /* Mobilde metin tek sütun ve görselin ÜSTÜNDE durur; bu yüzden perde
     soldan sağa değil YUKARIDAN AŞAĞIYA çalışır ve maske kalkar —
     yoksa yazının arkası açıkta kalırdı. */
  @media (max-width: 60rem) {

    /* Mobilde hero TAM EKRAN DEĞİL — kasıtlı.
       `object-fit: cover` kutuyu doldurmak zorunda olduğu için, kutu ne
       kadar uzunsa görsel o kadar yakından kırpılıyor. Tam ekran
       yükseklikte 3:2'lik kaynağın genişliğinin ancak %34'ü görünüyor
       ve görsel "çok yakın" duruyordu. Yükseklik kısalınca kırpma
       azalır: bu ölçüde genişliğin ~%42'si görünür. İçeriğin doğal
       yüksekliği 496px olduğu için metin de sıkışmaz. */
    /* Mobilde ölçü hero'nun TAMAMINA değil, görselli/metinli alana
       verilir: o alan ekranın yarısını kaplar, logo şeridi hemen
       altında kalır — örnek sitedeki oran bu. Hero'nun kendi
       min-height'ı kalkar, toplam yükseklik içerikten gelir. */
    .hero-background {
      min-height: 0;
    }
    /* Görselli/metinli alan ekranın yarısına yakın kalsın diye dikey
       boşluklar kısılır. Ölçü mavi ŞERİDİ de kapsar: header 77px yer
       tuttuğu için, bu alanın ekranda %50'de bitmesi metnin 345px'e
       sığmasını gerektirir — mevcut metin (4 satır alt başlık) buna
       sığmıyor. Kısılabilecek her şey kısıldı. */
    .hero-background .hero-inner {
      min-height: 42dvh;
      padding-block: 0.9rem;
    }
    /* Alt metin mobilde GÖRÜNMEZ — dar ekranda yalnızca başlık ve
       butonlar kalsın istendi. Masaüstünde ikisi de durur. Metin
       sayfadan silinmedi, yalnızca bu genişlikte gizlenir. */
    .hero-background .hero-lead {
      display: none;
    }
    /* Başlıkla butonlar arasındaki boşluğu normalde alt metnin alt payı
       veriyordu; o gizlenince buton satırı başlığa yapışıyor. Boşluk
       burada yeniden kurulur. */
    .hero-background .btn-row {
      margin-top: var(--space-md);
      gap: 0.5rem;
    }
    /* Butonlar mobilde daha derli toplu. Küçülen şey KUTU: dikey ve
       yatay iç boşluk azalır, yazı ölçüsü aynı kalır — metin net ve
       okunur kalsın diye. Yükseklik 46px'te tutulur; denetimin dokunma
       hedefi eşiği 44px, altına inilmez. */
    .hero-background .btn-row .btn {
      padding: 0.5rem 1rem;
      min-height: 46px;
    }
    /* Dar ekranda 3:2 kaynaktan dikey bir dilim kırpılıyor; robotlar
       görselin SAĞINDA olduğu için kırpma oraya kaydırılır, yoksa
       ekranda yalnızca arka plandaki ekranlar kalıyor. Kırpma azalınca
       bu kaydırma da azaltıldı. */
    .hero-bg img {
      object-position: 74% center;
    }
    /* Perde masaüstündekinden HAFİF: burada metnin arkasını tümüyle
       kapatmak gerekmiyor, üstte görsel açıkta kalsın diye yukarıdan
       aşağıya koyulaşır. */
    /* Dar ekranda metin tek sütun ve fotoğrafın ÜSTÜNDE; net kare de
       buğulu katmana daha erken karışır. */
    .hero-bg-sharp {
      -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 45%);
      mask-image: linear-gradient(to right, transparent 0%, #000 45%);
    }
    .hero-scrim {
      background: linear-gradient(
        to bottom,
        rgba(6, 36, 37, 0.24) 0%,
        rgba(6, 36, 37, 0.42) 45%,
        rgba(6, 36, 37, 0.5) 100%
      );
    }
  }

  /* ---------- Çözümler ---------- */
  .solutions-grid {
    align-items: stretch;
  }
  .solutions-all {
    margin-top: var(--space-md);
  }

  /* ---------- Neden CPeak ---------- */
  .why-section {
    background: var(--surface);
