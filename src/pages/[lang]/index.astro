---
import Base from '@/layouts/Base.astro';
import Ledger from '@/components/Ledger.astro';
import References from '@/components/References.astro';
import SolutionCard from '@/components/SolutionCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import { LANGS, SOLUTION_KEYS, path, type Lang } from '@/i18n/routes';
import { site } from '@/config/site';
import { t } from '@/i18n/ui';
import { figures } from '@/data/figures';
import { home } from '@/data/home';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const ui = t(lang);
const c = home[lang];

/** Hero görsel seçeneği — src/config/site.ts içinden. */
const heroVisual = site.hero.visual;
const isLedger = heroVisual === 'ledger';
const isBackground = heroVisual === 'background';
/** 'duotone' eski kuantum kaynağında kalır; 'image' ve 'background' yeni
 * fotoğrafı (hero-team.webp) kullanır — ikisinin doğal boyutu farklı
 * olduğu için width/height de görsele göre ayrılır (CLS'i önlemek için). */
const imageSrc =
  heroVisual === 'duotone' ? '/media/quantum-duotone.webp' : '/media/hero-team.webp';
const imageDims =
  heroVisual === 'duotone' ? { w: 800, h: 942 } : { w: 1200, h: 800 };
---

<Base
  lang={lang}
  ref={{ page: 'home' }}
  title={c.meta.title}
  description={c.meta.description}
  darkTop={false}
  preloadImage={isLedger ? undefined : imageSrc}
>
  <!-- ============ 1. HERO ============
       Görsel seçeneği src/config/site.ts → hero.visual ile değişir:
       'ledger' | 'image' | 'duotone' | 'background'                  -->
  <section class:list={['hero', `hero-${heroVisual}`]} data-hero>
    {
      /* SAHNE: solda mimari yüzey, sağda fotoğraf.
         İki ayrı katman — fotoğrafın üzerine gradient atmak yerine
         yüzeyin kendisi bir katman, fotoğraf ayrı bir katman. Fotoğraf
         sola doğru uzun bir maskeyle söner ve altındaki yüzey ortaya
         çıkar; böylece geçiş "fotoğrafa gradient uygulanmış" gibi
         değil, aynı mekânın duvarı sola devam ediyormuş gibi okunur. */
      isBackground && (
        <div class="hero-scene" aria-hidden="true">
          <div class="hero-wall" />
          <div class="hero-photo">
            <img
              src={imageSrc}
              width={imageDims.w}
              height={imageDims.h}
              alt=""
              fetchpriority="high"
            />
          </div>
        </div>
      )
    }

    {!isBackground && <Ledger variant="texture" tone="light" class="hero-texture" />}

    <div class="container hero-inner">
      <div class="hero-copy reveal">
        <h1>{c.hero.h1}</h1>
        <p class="lead hero-lead">{c.hero.lead}</p>
        <div class="btn-row">
          <a href={path({ page: 'contact' }, lang)} class="btn btn-primary">{c.hero.primaryCta}</a>
          <a href={path({ page: 'solutions' }, lang)} class="btn btn-secondary">
            {c.hero.secondaryCta}
          </a>
        </div>
      </div>

      {
        !isBackground && (
          <figure class="hero-figure reveal" data-delay="1">
            {isLedger ? (
              <>
                <Ledger variant="hero" />
                <figcaption class="sr-only">{c.hero.figureAlt}</figcaption>
              </>
            ) : (
              <div class:list={['hero-panel', heroVisual === 'image' && 'hero-panel--photo']}>
                <img
                  src={imageSrc}
                  width={imageDims.w}
                  height={imageDims.h}
                  alt={c.hero.imageAlt}
                  fetchpriority="high"
                />
              </div>
            )}
          </figure>
        )
      }
    </div>
  </section>

  <!-- ============ 2. REFERANSLAR ŞERİDİ ============
       Hero'nun hemen altındaki koyu zeminli logo şeridi.
       Liste ve ölçü mantığı: src/data/references.ts             -->
  <References lang={lang} />

  <!-- ============ 3. ÇÖZÜMLER IZGARASI ============ -->
  <section class="section" id="solutions">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">{c.solutions.eyebrow}</p>
        <h2>{c.solutions.h2}</h2>
        <p class="lead">{c.solutions.lead}</p>
      </div>

      <div class="grid grid-3 solutions-grid">
        {SOLUTION_KEYS.map((key, i) => <SolutionCard lang={lang} solution={key} delay={i} />)}
      </div>

      <p class="solutions-all reveal">
        <a href={path({ page: 'solutions' }, lang)} class="link-arrow">{c.solutions.allLink}</a>
      </p>
    </div>
  </section>

  <!-- ============ 4. NEDEN CPEAK ============ -->
  <section class="section why-section">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">{c.why.eyebrow}</p>
        <h2>{c.why.h2}</h2>
        <p class="lead">{c.why.lead}</p>
      </div>

      <div class="grid grid-4 why-grid">
        {
          c.why.items.map((item, i) => (
            <div class="why-item reveal" data-delay={String(Math.min(i, 3))}>
              <hr class="rule-teal" />
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ 5. YAPAY ZEKÂ YAKLAŞIMIMIZ ============
       Ayrı, koyu lacivert zeminli bölüm. -->
  <section class="section ai-section on-dark">
    <Ledger variant="texture" tone="dark" />

    <div class="container ai-inner">
      <div class="section-head reveal">
        <p class="eyebrow">{c.aiSection.eyebrow}</p>
        <h2>{c.aiSection.h2}</h2>
        <p class="lead">{c.aiSection.lead}</p>
      </div>

      <div class="grid grid-2 ai-grid">
        <div class="ai-col reveal">
          <h3>{c.aiSection.forClients.title}</h3>
          <p>{c.aiSection.forClients.body}</p>
          <ul class="dashlist">
            {c.aiSection.forClients.items.map((i) => <li>{i}</li>)}
          </ul>
        </div>

        <div class="ai-col reveal" data-delay="1">
          <h3>{c.aiSection.ourPractice.title}</h3>
          <p>{c.aiSection.ourPractice.body}</p>
          <ul class="dashlist">
            {c.aiSection.ourPractice.items.map((i) => <li>{i}</li>)}
          </ul>
        </div>
      </div>

      <p class="ai-stance reveal">{c.aiSection.stance}</p>
    </div>
  </section>

  <!-- ============ 6. ÇALIŞMA YAKLAŞIMI ============
       Monospace numaralandırma burada anlamlı: gerçekten sıralı
       bir süreci gösteriyor. -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">{c.process.eyebrow}</p>
        <h2>{c.process.h2}</h2>
        <p class="lead">{c.process.lead}</p>
      </div>

      <img
        class="section-figure reveal"
        src={figures.process.src[lang]}
        width="1536"
        height="1024"
        alt={figures.process.alt[lang]}
        loading="lazy"
        decoding="async"
      />

      <ol class="process-list">
        {
          c.process.steps.map((step, i) => (
            <li class="process-step reveal" data-delay={String(Math.min(i, 3))}>
              <span class="process-no mono">{step.no}</span>
              <h3 class="process-title">{step.title}</h3>
              <p class="process-what">{step.what}</p>
              <dl class="process-meta">
                <div>
                  <dt class="mono">{ui.common.deliverables}</dt>
                  <dd>{step.deliverable}</dd>
                </div>
                <div>
                  <dt class="mono">{ui.common.typicalDuration}</dt>
                  <dd>{step.duration}</dd>
                </div>
              </dl>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ 7. TİPİK PROJE SENARYOLARI ============
       Gerçek müşteri vakası DEĞİL — her kart açıkça işaretli. -->
  <section class="section scenarios-section">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">{c.scenarios.eyebrow}</p>
        <h2>{c.scenarios.h2}</h2>
        <p class="lead">{c.scenarios.lead}</p>
      </div>

      <p class="scenario-disclaimer reveal">{c.scenarios.disclaimer}</p>

      <div class="grid grid-3 scenario-grid">
        {
          c.scenarios.items.map((s, i) => (
            <article class="card scenario-card reveal" data-delay={String(Math.min(i, 3))}>
              <p class="scenario-tag mono">{c.scenarios.tag}</p>
              <h3 class="scenario-sector">{s.sector}</h3>
              <p class="scenario-scale mono">{s.scale}</p>

              <dl class="scenario-body">
                <dt>{lang === 'tr' ? 'Tipik problem' : 'The problem'}</dt>
                <dd>{s.problem}</dd>
                <dt>{lang === 'tr' ? 'İzlenen yaklaşım' : 'Our approach'}</dt>
                <dd>{s.approach}</dd>
                <dt>{lang === 'tr' ? 'Beklenen kazanım' : 'Expected outcome'}</dt>
                <dd>{s.outcome}</dd>
              </dl>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ 8. KAPANIŞ CTA ============ -->
  <CtaBand lang={lang} text={c.closing.text} cta={c.closing.cta} />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 1rem + 6vw, 5.5rem) clamp(3rem, 1.5rem + 6vw, 6rem);
  }
  .hero-texture {
    /* Doku yalnızca sağ tarafa doğru açılır, metnin altında kalmaz. */
    left: 40%;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }

  .hero-lead {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .hero-figure {
    margin: 0;
  }

  @media (min-width: 60rem) {
    .hero-inner {
      grid-template-columns: 1.15fr 1fr;
      gap: var(--space-xl);
    }
  }

  /* ---------- Hero seçeneği: görsel panel (image / duotone) ----------
     Kesim görselin siyah zemini kaldırıldığı için nesne lacivert
     panelin üzerinde serbest durur; kutu içinde fotoğraf gibi değil,
     markanın zemini üzerinde bir nesne gibi okunur. */
  .hero-panel {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 480 / 420;
    padding: clamp(0.75rem, 0.4rem + 1.5vw, 1.75rem);
    background: var(--navy);
    border-radius: var(--radius);
    overflow: hidden;
  }
  /* Panelin içinde çok soluk defter çizgileri: görsel değişse de
     markanın imza dokusu tamamen kaybolmaz. */
  .hero-panel::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.07) 0 1px,
      transparent 1px 34px
    );
    pointer-events: none;
  }
  .hero-panel img {
    position: relative;
    max-height: 100%;
    width: auto;
    object-fit: contain;
  }

  /* ---------- Hero seçeneği: gerçek fotoğraf (image, opak dikdörtgen) ----
     hero-team.webp saydam kesim değil, dolu bir fotoğraf — lacivert/teal
     panel zemini ve iç boşluk (padding) fotoğrafın etrafında renkli bir
     çerçeve gibi görünüyordu. Fotoğrafta bu istenmiyor: zemin şeffaf,
     boşluk sıfır, görsel kendi en/boy oranıyla (3/2) çerçeveyi eksiksiz
     doldurur — arkasında hiçbir renk kalmaz. */
  .hero-panel--photo {
    aspect-ratio: 3 / 2;
    padding: 0;
    background: transparent;
  }
  .hero-panel--photo::before {
    display: none;
  }
  .hero-panel--photo img {
    width: 100%;
    height: 100%;
    max-height: none;
    object-fit: cover;
  }

  /* ==================================================================
     HERO SEÇENEĞİ: 'background' — solda mimari yüzey, sağda fotoğraf
     ==================================================================
     Kompozisyon üç bölge:
       SOL  %42  temiz metin alanı, sade mimari yüzey
       ORTA %17  kontrollü geçiş — YALNIZCA fotoğrafın sol kenarında
       SAĞ  %41  fotoğraf; net, güçlü, kendi ışığıyla

     BURADA YAPILMAYAN ŞEYLER (bilerek):
     Fotoğrafa opaklık düşürme, beyaza karıştırma, çevresine feather /
     glow / sis verme, üst-alt kenarlara sönüm koyma. Bunların hepsi
     fotoğrafın etrafında beyaz bir bulut oluşturuyor ve görseli
     öldürüyordu. Fotoğraf TAM opak ve filtresiz; geçiş yalnızca sol
     kenardaki dar bir bantta, maskeyle.

     Yüzeyin tonu tahmin değil ÖLÇÜM: fotoğrafın sol kenar bölgesinin
     ortalaması #2b2f33. Duvar bu tonda kurulduğu için iki katman aynı
     malzeme gibi okunuyor; arada renk sıçraması olmuyor. */
  .hero-background {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(calc(100svh - var(--header-h)), 44rem);
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
    background: #2b2f33;
    color: #fff;
  }

  .hero-scene {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* --- Mimari yüzey ---
     Bulanıklık YOK. Yüzeyi yüzey yapan üç şey var, üçü de ince:
     ışığın sağdan gelmesi (fotoğraftaki ekran ışığının devamı),
     zeminde çok soluk dikey panel çizgileri, ve alta doğru hafif
     koyulaşma. Hiçbiri desen gibi okunmuyor. */
  .hero-wall {
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(
        to right,
        rgba(255, 255, 255, 0.022) 0 1px,
        transparent 1px 148px
      ),
      linear-gradient(to bottom, rgba(0, 0, 0, 0) 55%, rgba(0, 0, 0, 0.22) 100%),
      linear-gradient(100deg, #24282c 0%, #292d31 42%, #2b2f33 72%, #2f3439 100%);
  }

  /* --- Fotoğraf ---
     Net, opak, filtresiz ve TÜM hero'yu kaplar.
     Önceden yalnızca sağ %54'teydi; solda düz, boş bir koyu panel
     kalıyor ve metin alanı fotoğraftan kopuk, ayrı bir kutu gibi
     duruyordu. Şimdi maske sola doğru çok düşük bir yoğunluğa iniyor
     ama SIFIRA inmiyor: metnin arkasında fotoğrafın dokusu seziliyor,
     detayı okunmuyor. Sağa gidildikçe tam netliğe çıkıyor — tek bir
     mekân gibi. (Mobildeki kurulumun yatay eksendeki karşılığı.)

     Tam genişlikte kapsama ölçeği yatayda 1:1 olduğu için yatay kırpma
     yok — karenin tamamı görünür, yani görüntü de uzaklaşmış olur.
     Dikeyde kırpma var ve `center` masayı alttan bir miktar kesiyor. */
  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
  }
  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% center;
    -webkit-mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0.1) 0%,
      rgba(0, 0, 0, 0.13) 30%,
      rgba(0, 0, 0, 0.2) 42%,
      rgba(0, 0, 0, 0.42) 53%,
      rgba(0, 0, 0, 0.78) 65%,
      #000 78%
    );
    mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0.1) 0%,
      rgba(0, 0, 0, 0.13) 30%,
      rgba(0, 0, 0, 0.2) 42%,
      rgba(0, 0, 0, 0.42) 53%,
      rgba(0, 0, 0, 0.78) 65%,
      #000 78%
    );
  }

  /* Metin sütunu sol %42'de biter — fotoğrafın görünmeye başladığı
     yerin gerisinde. */
  .hero-background .hero-inner {
    display: block;
  }
  .hero-background .hero-copy {
    max-width: min(34rem, 44%);
  }
  .hero-background h1 {
    color: #fff;
    /* Bu kompozisyonda başlık DAR bir sütunda duruyor; sayfanın
       genel h1 ölçüsü (64px) burada altı satıra bölünüyor, hem
       tipografi bozuluyor hem hero ekranı aşıyordu. Ölçü sütuna göre
       yeniden kuruldu — hero başlığı olarak hâlâ güçlü, ama üç-dört
       satırda kalıyor. */
    font-size: clamp(2rem, 1.15rem + 1.9vw, 2.9rem);
    line-height: 1.12;
  }
  .hero-background .hero-lead {
    color: var(--text-on-dark-muted);
  }
  /* Butonlar opak, marka renklerinde ve sayfanın genel buton
     ölçüsünden bir tık KÜÇÜK — hero'da başlığın yanında daha derli
     toplu duruyorlar. Yükseklik 46px'te tutuldu: denetimin dokunma
     hedefi eşiği 44px, altına inilmiyor. */
  .hero-background .btn-row .btn {
    padding: 0.55rem 1.15rem;
    min-height: 46px;
    font-size: 0.95rem;
  }
  .hero-background .btn-primary {
    background: #fff;
    color: var(--navy);
    border-color: #fff;
  }
  .hero-background .btn-primary:hover {
    background: var(--amber);
    color: var(--ink);
    border-color: var(--amber);
  }
  .hero-background .btn-secondary {
    background: var(--surface-darkest);
    color: #fff;
    border-color: var(--surface-darkest);
  }
  .hero-background .btn-secondary:hover {
    background: var(--navy);
    border-color: var(--navy);
    color: #fff;
  }

  /* ÇOK GENİŞ EKRAN (1600px+).
     Fotoğraf viewport'a, metin ise ortalanmış container'a göre
     hizalanıyor. Ekran büyüdükçe container sabit kaldığı için metin
     sütunu fotoğrafın başladığı yere doğru sıkışıyor ve başlık
     gereksiz yere çok satıra bölünüyordu. Bu ölçüde fotoğraf biraz
     sağa çekilip metne yer açılır; 40/20/40 oranı korunur. */
  @media (min-width: 100rem) {
    .hero-background .hero-copy {
      max-width: min(40rem, 50%);
    }
  }

  @media (max-width: 60rem) {
    /* Dar ekranda aynı mantık, ekseni dönük: yüzey üstte, fotoğraf
       altta. Geçiş yine dar ve kontrollü — fotoğrafın üst kenarında. */
    /* Hero + header, ekranın yaklaşık ÜÇTE İKİSİNİ kaplar; referans
       şeridi ilk ekranın altında başlar. Sayfa açıldığında altında
       devam eden içerik olduğu görünür. */
    .hero-background {
      min-height: min(calc(66svh - var(--header-h)), 30rem);
      padding-block: clamp(1.25rem, 1rem + 1.5vw, 2rem) 0;
      align-items: flex-start;
    }
    /* Fotoğraf metnin bulunduğu bölgeye kadar UZANIR.
       Önceden alt yarıda başlıyordu ve üstte düz, boş bir koyu panel
       kalıyordu; metin alanı fotoğraftan kopuk, ayrı bir kutu gibi
       duruyordu. Şimdi kutu neredeyse tüm hero'yu kaplıyor ve maske
       yukarıya doğru çok düşük bir yoğunlukta sönüyor: metnin arkasında
       fotoğrafın dokusu SEZİLİYOR ama detayı okunmuyor. Aşağı indikçe
       tam netliğe çıkıyor — tek bir mekân gibi. */
    /* Katman hero'dan UZUN ve üste yaslı; taşan alt kısmı .hero-scene
       kırpar. Sebebi: dar ekranda kutunun oranı 3:2 kaynağı dikeyde hiç
       kırpmıyordu, dolayısıyla karenin en altındaki masa tamamen
       görünüyor ve gereğinden fazla yer kaplıyordu. Kutu uzayınca
       görünen alan karenin üst kısmına denk gelir: robotlar ve ekran
       kalır, masa büyük ölçüde çıkar.

       ÖLÇÜ BİR DENGE: kutu uzadıkça masa daha çok çıkıyor ama görüntü
       de o kadar YAKINLAŞIYOR (kapsama ölçeği yükseliyor). Ölçülen
       değerler — görünen genişlik / yükseklik:
         %134 → %40 / %75   masa temiz ama çok yakın
         %118 → %46 / %85   denge burada
         %108 → %50 / %93   uzak ama masa geri geliyor */
    .hero-photo {
      inset: 0 0 auto 0;
      width: 100%;
      height: 118%;
    }
    .hero-photo img {
      object-position: 74% 38%;
      /* Duraklar kutunun TAMAMINA göre; görünen alan kutunun ilk
         ~%75'i olduğu için tam netlik %58'de tamamlanır, yoksa
         fotoğraf ekranda hiç netleşmezdi. */
      -webkit-mask-image: linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.1) 0%,
        rgba(0, 0, 0, 0.16) 19%,
        rgba(0, 0, 0, 0.26) 29%,
        rgba(0, 0, 0, 0.55) 40%,
        rgba(0, 0, 0, 0.85) 50%,
        #000 58%
      );
      mask-image: linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.1) 0%,
        rgba(0, 0, 0, 0.16) 19%,
        rgba(0, 0, 0, 0.26) 29%,
        rgba(0, 0, 0, 0.55) 40%,
        rgba(0, 0, 0, 0.85) 50%,
        #000 58%
      );
    }
    .hero-background .hero-copy {
      max-width: none;
    }
    /* Dar ekranda hero'da yalnızca başlık ve butonlar kalır; alt metin
       gizlenir. Masaüstünde ikisi de durur. Metin sayfadan silinmiyor,
       yalnızca bu genişlikte gizleniyor. */
    .hero-background .hero-lead {
      display: none;
    }
    /* Başlıkla butonlar arasındaki boşluğu normalde alt metnin alt payı
       veriyordu; gizlenince buton satırı başlığa yapışıyor. Ölçü dar
